{
  "name": "goose-lane",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-mobile-art.mjs --check && tsc -b && vite build && node scripts/package-notices.mjs && node scripts/stamp-release.mjs && node scripts/build-sw.mjs && node scripts/performance-budget.mjs",
    "package:food-preview": "node scripts/package-food-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "simulate": "tsx src/diagnostics/simulate.ts",
    "art:build": "node scripts/build-b-art.mjs",
    "art:check": "node scripts/check-b-art.mjs",
    "simulate:v3": "tsx src/diagnostics/complete-v3.ts",
    "content:export": "tsx scripts/export-v3-catalog.ts",
    "art:check:v3": "node scripts/check-v3-art.mjs",
    "art:build:v3": "node artwork/v3-b/draw-masters.mjs && node scripts/package-v3-b-art.mjs",
    "art:build:mobile": "node scripts/build-mobile-art.mjs",
    "art:check:mobile": "node scripts/build-mobile-art.mjs --check"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "phaser": "4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.4",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
